{
	# No global order override needed; anubis registers itself after templates.
}

:8080 {
	request_header +X-Real-IP {remote_host}
	request_header +X-Forwarded-For {remote_host}

	# Provisions the global Anubis server and serves static assets at /.within.website/
	init_anubis

	handle {
		anubis

		try_files {path} /index.html
		file_server {
			root web/
			browse
		}
	}
}
